{
  "info": {
    "name": "People Hub API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Departments",
      "item": [
        {
          "name": "Create Department",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/departments",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentName\": \"Engineering\"\n}"
            }
          }
        },
        {
          "name": "Get All Departments",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/departments"
          }
        },
        {
          "name": "Update Department",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/departments/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentName\": \"Product\"\n}"
            }
          }
        },
        {
          "name": "Delete Department",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/departments/1"
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/employees",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeCode\": \"EMP001\",\n  \"fullName\": \"Rahul Mehta\",\n  \"email\": \"rahul@example.com\",\n  \"mobile\": \"9876543210\",\n  \"departmentId\": 1,\n  \"designation\": \"Backend Developer\",\n  \"salary\": 50000,\n  \"status\": \"Active\"\n}"
            }
          }
        },
        {
          "name": "Get All Employees",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/employees?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["employees"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "departmentId", "value": "", "disabled": true },
                { "key": "status", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Employee by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/employees/1"
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/employees/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Kumar\",\n  \"email\": \"rahul.kumar@example.com\",\n  \"mobile\": \"9876543210\",\n  \"departmentId\": 1,\n  \"designation\": \"Senior Developer\",\n  \"salary\": 65000\n}"
            }
          }
        },
        {
          "name": "Delete Employee",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/employees/1"
          }
        },
        {
          "name": "Update Employee Status",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/employees/1/status",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Inactive\"\n}"
            }
          }
        },
        {
          "name": "Export Employees CSV",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/employees/export"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/dashboard"
          }
        }
      ]
    }
  ]
}
